MULTISEARCH_API_PORT=8765
MULTISEARCH_CONSOLE_PORT=3000
MULTISEARCH_PUBLIC_API_BASE_URL=http://127.0.0.1:8765
MULTISEARCH_PUBLIC_CONSOLE_URL=http://127.0.0.1:3000
MULTISEARCH_TRUSTED_PROXIES=
MULTISEARCH_ENABLE_DDGS=true
MULTISEARCH_ENABLE_WIKIPEDIA=false
MULTISEARCH_ENABLE_IMAGE_SEARCH=true
MULTISEARCH_MAX_CONCURRENT_REQUESTS=20
MULTISEARCH_POLICY_PATH=./config.example.yaml
MULTISEARCH_ENABLE_ACADEMIC=false
MULTISEARCH_ENABLE_LOCAL_INDEX=false
MULTISEARCH_ENABLE_DEEP_RESEARCH=false
# compose.workers.yml enables three workers; override the count if needed.
MULTISEARCH_WORKER_REPLICAS=3
# Optional fixed HTTPS DNS endpoint for proxy Fake-IP deployments.
MULTISEARCH_FETCH_DOH_URL=
MULTISEARCH_RESEARCH_MODEL_BACKEND=
MULTISEARCH_RESEARCH_MODEL_BASE_URL=
MULTISEARCH_RESEARCH_MODEL_NAME=
MULTISEARCH_RESEARCH_COST_CURRENCY=
MULTISEARCH_RESEARCH_INPUT_PER_MILLION_TOKENS=
MULTISEARCH_RESEARCH_OUTPUT_PER_MILLION_TOKENS=
MULTISEARCH_VERTICAL_SOURCES=
CRAWL4AI_BASE_URL=
MULTISEARCH_DYNAMIC_FETCH_DOMAINS=
MULTISEARCH_DYNAMIC_FETCH_RESOURCE_DOMAINS=
MULTISEARCH_DYNAMIC_FETCH_RESOURCES=
